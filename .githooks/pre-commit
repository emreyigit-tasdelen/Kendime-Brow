#!/bin/sh
# Blocks commits that contain secrets or personal data. Enabled with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found. Install it (winget install Gitleaks.Gitleaks) — commit blocked." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml || {
  echo "pre-commit: possible secret or personal data found — commit blocked." >&2
  exit 1
}
